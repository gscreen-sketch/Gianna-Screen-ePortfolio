<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_white">

<!--    Title text-->
    <TextView
        android:id="@+id/Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SMS Notifications"
        android:textColor="@color/text_dark"
        android:textSize="24sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="280dp"/>

<!--    Status Text-->
    <TextView
        android:id="@+id/Status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: inactive"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/Title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="20dp"/>

<!--    Enable SMS Button-->
    <Button
        android:id="@+id/Enable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enable SMS"
        android:backgroundTint="@color/brand_yellow"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toBottomOf="@id/Status"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="20dp"/>

<!--    CS499 Capstone enhancement: Low stock list (InventoryOrganizer) -->
    <TextView
        android:id="@+id/lowStockList"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="Low stock items: none"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/Enable"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
