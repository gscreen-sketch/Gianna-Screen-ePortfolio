<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_white">

<!--    Title Text-->
    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inventory Items"
        android:textSize="22sp"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="20dp"/>

<!--    Add New Item text-->
    <TextView
        android:id="@+id/AddItemLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add New Item"
        android:textSize="16sp"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toBottomOf="@id/pageTitle"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"/>

<!--    Item Name Input-->
    <EditText
        android:id="@+id/ItemName"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:hint="Item Name"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toBottomOf="@id/AddItemLabel"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="20dp"/>

<!--    Item Quantity Input-->
    <EditText
        android:id="@+id/Quantity"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:hint="Qty"
        android:inputType="number"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toBottomOf="@id/AddItemLabel"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"/>

<!--    Add Item Button-->
    <Button
        android:id="@+id/buttonAddItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Add Item"
        android:backgroundTint="@color/brand_yellow"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toBottomOf="@id/ItemName"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"/>

    <View
        android:id="@+id/line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/divider_gray"
        app:layout_constraintTop_toBottomOf="@id/buttonAddItem"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="10dp"/>

    <LinearLayout
        android:id="@+id/gridHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/brand_black"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp">

<!--        Item Name Column Title-->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Item Name"
            android:textColor="@color/text_light"
            android:textSize="14sp"/>

<!--        Item Quantity Column Title-->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quantity"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:gravity="center"/>

<!--        Action Column Title Button-->
        <TextView
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:text="Action"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:gravity="center"/>
    </LinearLayout>

<!--    CS499 Capstone enhancement: RecyclerView-based inventory list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/inventoryRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/gridHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
