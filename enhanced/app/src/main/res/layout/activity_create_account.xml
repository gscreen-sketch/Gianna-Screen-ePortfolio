<?xml version="1.0" encoding="utf-8"?>
<!-- CS499 Capstone enhancement: Dedicated create-account screen -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_white">

<!--    Title Text-->
    <TextView
        android:id="@+id/createAccountTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Account"
        android:textSize="26sp"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="140dp"/>

<!--    Username Input-->
    <EditText
        android:id="@+id/NewUsername"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:hint="Username"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toBottomOf="@id/createAccountTitle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="40dp"/>

<!--    Password Input-->
    <EditText
        android:id="@+id/NewPassword"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:inputType="textPassword"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toBottomOf="@id/NewUsername"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="20dp"/>

<!--    Create Account Button-->
    <Button
        android:id="@+id/SubmitCreateAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Account"
        android:backgroundTint="@color/brand_yellow"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toBottomOf="@id/NewPassword"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="30dp"/>

<!--    Back To Login Button-->
    <Button
        android:id="@+id/BackToLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back to Login"
        android:backgroundTint="@color/brand_black"
        android:textColor="@color/text_light"
        app:layout_constraintTop_toBottomOf="@id/SubmitCreateAccount"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
